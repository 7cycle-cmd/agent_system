# Project specific
hb_snapshots/
fault_evidence/
# qc_evidence: ignore the CONTENTS, not the dir, so the plan/agent-log
# deliverable can be re-included by pattern. A negation CANNOT re-include a
# file inside an excluded PARENT dir (MEASURED 2026-09-30), so `qc_evidence/`
# would make the `!` lines below no-ops. `qc_evidence/*` excludes the contents
# while leaving the dir itself traversable.
qc_evidence/*
!qc_evidence/plan_*.md
!qc_evidence/agent_log_*.md
!qc_evidence/plan_*.json
!qc_evidence/agent_log_*.json
hko_proof/
helper_watchdog.pid

# Generated evidence / captures (plan CHAT.PIPELINE.S9, S9-pre-b batch 2a).
# MEASURED 2026-09-30: these dirs were untracked AND not ignored, so a
# `git add -A` would have committed 10520 generated files. They are OUTPUTS,
# not source. The dirs have NO leading dot (the plan wrote `.evidence/` etc.;
# the real names are `evidence/` etc.).
evidence/
evidence_final/
evidence_steps/
evidence_redbox/
chrome_cdp_profile/
debug_shots/
out/
diag/
mouse_spot_targets/crosshair/

# Node dependencies (plan CHAT.PIPELINE.S17, step S17-a).
# MEASURED 2026-09-30: 1929 files under `node_modules/` were TRACKED (69.6 MB),
# added by the initial commit. They are INSTALLED OUTPUTS, not source — the
# `package-lock.json` files ARE tracked (the correct thing to track), so a
# `npm ci` reproduces them. Untracked here; the files stay on disk.
node_modules/

